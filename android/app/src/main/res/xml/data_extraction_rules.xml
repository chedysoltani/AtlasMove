<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ : aucune donnée locale n'est sauvegardée dans le cloud ni copiée
  vers un nouvel appareil. Les tokens de session sont chiffrés par une clé du
  Keystore propre à l'appareil : les restaurer ailleurs les rendrait illisibles
  (InvalidKeyException) et déconnecterait l'utilisateur.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
