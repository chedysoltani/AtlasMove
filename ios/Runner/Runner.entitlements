<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Capacités des configurations Debug et Profile (CODE_SIGN_ENTITLEMENTS dans
	  project.pbxproj). La configuration Release (TestFlight / App Store) utilise
	  RunnerRelease.entitlements, identique sauf aps-environment = production.
	  Push Notifications et Associated Domains doivent aussi être cochés sur
	  l'identifiant com.atlasmove.atlasmove (developer.apple.com).
	-->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links (liens d'inscription des campagnes). Le fichier
	     apple-app-site-association doit être servi par les deux hôtes. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:atlasbusiness.online</string>
		<string>applinks:www.atlasbusiness.online</string>
	</array>
</dict>
</plist>
